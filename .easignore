# Files EAS Build should NOT upload with the build archive.
# EAS reads ignore rules from the git repo root (next to .gitignore) and a
# .easignore REPLACES .gitignore rules, so everything from .gitignore is
# mirrored here plus the hosted APK copy.

# dependencies
node_modules/

# expo / build output
.expo/
dist/
web-build/
expo-env.d.ts

# native dirs are generated on demand (continuous native generation)
android/
ios/

# logs and OS junk
*.log
.DS_Store
Thumbs.db

# netlify local state
.netlify/

# secrets and signing material
.env
.env.*
*.pem
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision

# the APK copy in public/ exists only for the website download link
public/qaza-tracker.apk
